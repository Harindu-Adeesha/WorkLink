<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E9ECEF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="@drawable/avatar_bg"
                android:padding="8dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tv_verify_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#14213d"/>

                <TextView
                    android:id="@+id/tv_verify_user_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Employer Profile"
                    android:textSize="12sp"
                    android:textColor="#035DD6"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tv_verify_user_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="john.doe@example.com"
                    android:textSize="12sp"
                    android:textColor="#6C757D"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_verify_user_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skills / Bio details..."
            android:textSize="13sp"
            android:textColor="#495057"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_user_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="View Details"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="6dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_give_verify_mark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Give Mark"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                android:backgroundTint="#198754"
                android:layout_marginStart="6dp"/>

            <TextView
                android:id="@+id/tv_verified_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✔ Verified"
                android:textColor="#198754"
                android:textStyle="bold"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_gravity="center_vertical"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
