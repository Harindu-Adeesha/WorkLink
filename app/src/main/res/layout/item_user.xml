<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E9ECEF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iv_user_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/avatar_bg"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#035DD6"
            android:layout_alignParentStart="true"
            android:layout_alignTop="@id/tv_user_name"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:id="@+id/layout_user_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iv_user_avatar"
            android:layout_toStartOf="@id/layout_actions"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textColor="#14213d"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_user_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#E7F1FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Freelancer"
                android:textColor="#035DD6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_user_header"
            android:layout_toEndOf="@id/iv_user_avatar"
            android:layout_toStartOf="@id/layout_actions"
            android:layout_marginTop="2dp"
            android:text="user@example.com"
            android:textColor="#6C757D"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_user_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_user_email"
            android:layout_toEndOf="@id/iv_user_avatar"
            android:layout_toStartOf="@id/layout_actions"
            android:layout_marginTop="4dp"
            android:text="Skills: Android, Kotlin"
            android:textColor="#495057"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageButton
                android:id="@+id/btn_edit_user"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#6C757D"
                android:layout_marginEnd="4dp"/>

            <ImageButton
                android:id="@+id/btn_delete_user"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#DC3545"/>
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
