<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    tools:context=".FreelancerDashboardActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            >
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/logo"
                android:scaleType="centerInside"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WorkLink"
                android:textColor="#035DD6"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_toolbar_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:text="Freelancer"
                android:textColor="#6C757D"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#E9ECEF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- TAB 1: JOB FEED -->
        <LinearLayout
            android:id="@+id/layout_jobs_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find Opportunities"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#14213d"/>

            <!-- Category Filter Horizontal Scroll -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_all"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:checked="true"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_dev"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Software Development"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_design"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UI/UX Design"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_writing"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Content Writing"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_marketing"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Digital Marketing"/>
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_jobs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- TAB 2: APPLICATIONS -->
        <LinearLayout
            android:id="@+id/layout_applications_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Applications"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#14213d"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track the status of your job applications and submit reviews."
                android:textColor="#6C757D"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_empty_applications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="64dp"
                android:text="You haven't applied for any jobs yet."
                android:textColor="#ADB5BD"
                android:textSize="16sp"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_applications"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>

        <!-- TAB 3: PROFILE (View / Create / Update / Delete) -->
        <ScrollView
            android:id="@+id/layout_profile_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 3a. NO PROFILE STATE -->
                <LinearLayout
                    android:id="@+id/profile_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:padding="16dp"
                        app:tint="#6C757D"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Profile Setup"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#14213d"
                        android:layout_marginTop="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create a profile to display your skills and apply for freelance jobs."
                        android:textColor="#6C757D"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_create_profile_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create Profile Now"
                        android:backgroundTint="#035DD6"/>
                </LinearLayout>

                <!-- 3b. VIEW PROFILE STATE -->
                <LinearLayout
                    android:id="@+id/profile_view_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E9ECEF"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_gravity="center_horizontal"
                                android:src="@android:drawable/ic_menu_myplaces"
                                android:background="@drawable/avatar_bg"
                                android:padding="12dp"/>

                            <TextView
                                android:id="@+id/tv_profile_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="12dp"
                                android:text="Freelancer Name"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#14213d"/>

                            <TextView
                                android:id="@+id/tv_profile_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:text="Mobile Application Consultant"
                                android:textColor="#035DD6"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tv_profile_rate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:text="$50.00 / hr"
                                android:textColor="#198754"
                                android:textStyle="bold"
                                android:textSize="14sp"/>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#E9ECEF"
                                android:layout_marginVertical="16dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bio"
                                android:textStyle="bold"
                                android:textColor="#14213d"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/tv_profile_bio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Professional bio goes here..."
                                android:textColor="#6C757D"
                                android:textSize="14sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="Skills"
                                android:textStyle="bold"
                                android:textColor="#14213d"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/tv_profile_skills"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Android, Kotlin, UI/UX"
                                android:textColor="#6C757D"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_profile"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Edit Profile"
                            app:strokeColor="#035DD6"
                            android:textColor="#035DD6"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_delete_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Delete Profile"
                            android:backgroundTint="#DC3545"
                            android:textColor="@android:color/white"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 3c. EDIT PROFILE STATE (CREATE / UPDATE FORM) -->
                <LinearLayout
                    android:id="@+id/profile_edit_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E9ECEF"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tv_form_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Update Freelancer Profile"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#14213d"/>

                            <!-- Name -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="Full Name"
                                android:textColor="#6C757D"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                            <EditText
                                android:id="@+id/et_profile_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Your Name"
                                android:textSize="14sp"
                                android:inputType="textPersonName"/>

                            <!-- Title -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Professional Title"
                                android:textColor="#6C757D"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                            <EditText
                                android:id="@+id/et_profile_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. Android Engineer"
                                android:textSize="14sp"
                                android:inputType="text"/>

                            <!-- Hourly Rate -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Hourly Rate"
                                android:textColor="#6C757D"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                            <EditText
                                android:id="@+id/et_profile_rate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. $50.00 / hr"
                                android:textSize="14sp"
                                android:inputType="text"/>

                            <!-- Bio -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Professional Bio"
                                android:textColor="#6C757D"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                            <EditText
                                android:id="@+id/et_profile_bio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Tell us about yourself..."
                                android:textSize="14sp"
                                android:inputType="textMultiLine"/>

                            <!-- Skills -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Skills / Area of Expertise (Tap to Select)"
                                android:textColor="#6C757D"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                            <EditText
                                android:id="@+id/et_profile_skills"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Tap to select one or multiple categories..."
                                android:textSize="14sp"
                                android:focusable="false"
                                android:clickable="true"
                                android:inputType="none"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_save_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Save"
                            android:backgroundTint="#035DD6"
                            android:textColor="@android:color/white"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel_profile_edit"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Cancel"
                            app:strokeColor="#6C757D"
                            android:textColor="#6C757D"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Logout Button (shared across states) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_freelancer_logout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Logout from Account"
                    android:backgroundTint="#6C757D"
                    android:padding="12dp"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/freelancer_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        app:menu="@menu/freelancer_nav_menu"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

