<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/dialog_job_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Post New Job"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#14213d"
            android:layout_marginBottom="16dp"/>

        <!-- Job Title -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.App.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dialog_job_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Job Title (e.g. Senior Android Engineer)"
                android:textColor="#000000"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Salary -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.App.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dialog_job_salary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Salary (e.g. $120k - $140k / year)"
                android:textColor="#000000"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.App.TextInputLayout.ExposedDropdownMenu">
            <AutoCompleteTextView
                android:id="@+id/et_dialog_job_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Category (e.g. Software Development)"
                android:textColor="#000000"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Deadline -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.App.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dialog_job_deadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Deadline (e.g. 2026-08-30)"
                android:textColor="#000000"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.App.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dialog_job_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Job Description"
                android:textColor="#000000"
                android:inputType="textMultiLine"
                android:minLines="3"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="end">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_job_cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#6C757D"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_job_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Save"
                android:backgroundTint="#035DD6"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
