<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Announcement"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#14213d"
            android:layout_marginBottom="16dp"/>

        <!-- Announcement Title -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.App.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_announcement_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Announcement Title"
                android:textColor="#000000"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Priority / Severity -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Priority / Severity"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#14213d"/>

        <Spinner
            android:id="@+id/spinner_announcement_priority"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/avatar_bg"
            android:paddingHorizontal="4dp"/>

        <!-- Target Audience -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target Audience"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#14213d"/>

        <Spinner
            android:id="@+id/spinner_announcement_audience"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/avatar_bg"
            android:paddingHorizontal="4dp"/>

        <!-- Message Body -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.App.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_announcement_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Message Body / Announcement Details"
                android:minLines="3"
                android:textColor="#000000"
                android:inputType="textMultiLine"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="end">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#6C757D"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Save"
                android:backgroundTint="#035DD6"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
