<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    tools:context=".RecruiterDashboardActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_sort_by_size">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WorkLink"
                android:textColor="#035DD6"
                android:textSize="18sp"
                android:textStyle="bold"/>
                
            <TextView
                android:id="@+id/tv_toolbar_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:text="Recruiter"
                android:textColor="#6C757D"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#E9ECEF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- TAB 1: DASHBOARD OVERVIEW -->
        <ScrollView
            android:id="@+id/layout_recruiter_dashboard_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recruiter Dashboard"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#14213d"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage job postings, verify accounts, and monitor reviews."
                    android:textColor="#6C757D"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"/>

                <!-- Action: Verify Job Posts -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E9ECEF">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VERIFY JOB POSTS"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#6C757D"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Review newly submitted job postings for authenticity. You can remove fake jobs or issue warning notes."
                            android:textSize="14sp"
                            android:textColor="#14213d"
                            android:layout_marginTop="8dp"/>
                            
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_verify_jobs"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:text="Manage Jobs"
                            android:backgroundTint="#035DD6"
                            app:cornerRadius="6dp"
                            android:layout_marginTop="16dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action: Verify User Accounts -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E9ECEF">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VERIFY ACCOUNTS"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#6C757D"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Review user profiles and grant verify marks to trusted accounts."
                            android:textSize="14sp"
                            android:textColor="#14213d"
                            android:layout_marginTop="8dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_verify_users"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:text="Verify Users"
                            android:backgroundTint="#035DD6"
                            app:cornerRadius="6dp"
                            android:layout_marginTop="16dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                
                <!-- Action: View Reviews -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E9ECEF">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VIEW REVIEWS"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#6C757D"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monitor reviews left on jobs and profiles to maintain community standards."
                            android:textSize="14sp"
                            android:textColor="#14213d"
                            android:layout_marginTop="8dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_view_reviews"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:text="View Reviews"
                            android:backgroundTint="#035DD6"
                            app:cornerRadius="6dp"
                            android:layout_marginTop="16dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: VERIFY JOBS -->
        <LinearLayout
            android:id="@+id/layout_recruiter_jobs_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify Jobs"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#14213d"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review and action pending job postings."
                android:textColor="#6C757D"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_recruiter_jobs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>

        <!-- TAB 3: VERIFY USERS -->
        <LinearLayout
            android:id="@+id/layout_recruiter_users_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify Users"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#14213d"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review user profiles and grant verification marks."
                android:textColor="#6C757D"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_recruiter_users"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>

        <!-- TAB 4: REVIEWS -->
        <LinearLayout
            android:id="@+id/layout_recruiter_reviews_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Reviews"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#14213d"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitor community reviews."
                android:textColor="#6C757D"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_recruiter_reviews"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>

        <!-- TAB 5: PROFILE -->
        <ScrollView
            android:id="@+id/layout_recruiter_profile_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#14213d"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your account settings."
                    android:textColor="#6C757D"
                    android:textSize="14sp"
                    android:layout_marginBottom="24dp"/>

                <!-- Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E9ECEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:background="@drawable/avatar_bg"
                            android:padding="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/tv_profile_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recruiter"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#14213d"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recruiter Role"
                                android:textSize="14sp"
                                android:textColor="#035DD6"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Role Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#14213d"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PERMISSIONS"
                            android:textSize="10sp"
                            android:textColor="#8B95A5"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verify Jobs"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verify Users"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manage Reviews"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_recruiter_logout"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Logout"
                    android:backgroundTint="#DC3545"
                    app:cornerRadius="8dp"
                    android:textSize="16sp"/>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/recruiter_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        app:menu="@menu/recruiter_nav_menu" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
